{
  "name": "sangre-y-jade",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Sangre y Jade — a Maya-inspired mobile-first survival roguelite.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "audio": "node scripts/generate-audio.mjs && node scripts/master-audio.mjs",
    "audio:skills": "node scripts/synth-sfx.mjs",
    "test:audio": "node scripts/sfx-playtest.mjs",
    "audio:check": "node scripts/check-audio.mjs",
    "test:audio-v06": "node --test tests/audio-v06.test.js",
    "test:audio-v06:browser": "node scripts/audio-v06-playtest.mjs",
    "test:i18n": "node scripts/check-i18n.mjs && node --test tests/i18n-v18.test.js tests/i18n-overhaul.test.js",
    "test:i18n:browser": "node scripts/v18-i18n-playtest.mjs",
    "art": "node scripts/prepare-art.mjs && node scripts/prepare-v03.mjs && node scripts/prepare-v04.mjs && node scripts/prepare-v05.mjs",
    "test": "node --test tests/*.test.js",
    "test:hud": "node scripts/skills-hud-playtest.mjs",
    "test:loading": "node scripts/loading-playtest.mjs",
    "test:settings": "node scripts/v06-settings-playtest.mjs",
    "test:viewport": "node scripts/v06-viewport-playtest.mjs",
    "test:sweep": "node scripts/invisible-player-sweep.mjs",
    "test:objects": "node --test tests/world-objects.test.js tests/render-layers.test.js tests/v13-maps.test.js",
    "test:objects:browser": "node scripts/world-objects-playtest.mjs",
    "test:typography": "node scripts/v06-typography-playtest.mjs",
    "test:ui-kit": "node scripts/ui-kit-playtest.mjs",
    "test:menus": "node scripts/v06-menu-playtest.mjs",
    "test:menu-update": "node scripts/menu-layout-update-playtest.mjs",
    "check": "npm run test && npm run build",
    "playtest": "node scripts/playtest.mjs",
    "marketing": "node scripts/capture-marketing.mjs",
    "android": "npm run build && node scripts/build-android.mjs",
    "release": "npm run check && node scripts/package-release.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "playwright-core": "1.55.0",
    "sharp": "^0.35.5",
    "vite": "7.3.6"
  }
}
